[Unit]
Description=HYDRA Dashboard API
After=network.target hydra.service
Wants=hydra.service

[Service]
Type=simple
User=calypso
Group=calypso
WorkingDirectory=/opt/calypso
ExecStart=/opt/calypso/.venv/bin/uvicorn dashboard.backend.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=10
StartLimitInterval=600
StartLimitBurst=5

# Environment
Environment=PYTHONPATH=/opt/calypso
Environment=DASHBOARD_CALYPSO_ROOT=/opt/calypso
Environment=DASHBOARD_AGENT_INTEL_DIR=/opt/calypso/intel

# 2026-09-18: the four DASHBOARD_{HYDRA_STATE,HYDRA_METRICS,BACKTESTING_DB,HYDRA_LOG}
# variables were REMOVED from this unit. Do not reintroduce them.
#
# They pinned the dashboard's fallback data paths to variant A. A VM-only drop-in
# (dashboard.service.d/primary-c.conf, written 2026-06-02 and never committed) then
# overrode them to variant C. Meanwhile config.py's own defaults said something else
# again — THREE sources of truth for one value, two of them naming a variant that
# stopped being the live seat on 2026-07-24, and the winner decided by systemd's
# drop-in precedence rather than by anyone's intent.
#
# These paths are LAST-RESORT FALLBACKS. Real resolution is dynamic and follows a
# live-seat swap with no config change at all:
#     variant_readers.live_seat_id() -> _seat_field() -> variant_<seat>_*
# The fallbacks now live in exactly one place, dashboard/backend/config.py, where
# test_dashboard_fallback_paths_track_the_live_seat pins them to the taxonomy's
# declared live seat — so the next swap fails a test instead of rotting silently.
#
# Setting them here again would re-establish an override that no test can see.
# Expose the A-vs-B-vs-C comparison view (/api/variants/*). The variant
# readers point at data/variant_{b,c}/ state + metrics + backtesting.db, which
# the broker-backed B/C now populate. (Off on Saxo too — this enables the full
# multi-strategy functionality now that B/C run.)
Environment=DASHBOARD_COMPARISON_MODE_ENABLED=true
# 2026-07-31: real per-account login (bcrypt + TOTP) replaces the old shared
# API key. Fail CLOSED if the accounts DB is empty — refuses to start rather
# than silently serving the public dashboard with no login gate (found in
# security review: a cold-deploy race or a misconfigured DB path would
# otherwise fail open). Bootstrap the first account BEFORE starting this
# service: .venv/bin/python -m scripts.manage_dashboard_users add <username>
Environment=DASHBOARD_REQUIRE_ACCOUNTS_CONFIGURED=true

# Resource limits
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
