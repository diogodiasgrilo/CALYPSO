[Unit]
Description=CALYPSO broker — single shared IBKR session service (ibind OAuth 1.0a)
# Owns the ONE IBKR brokerage session; HYDRA A/B/C reach it over loopback so
# they don't fight over the one-session-per-username limit. See
# docs/migration/BROKER_SESSION_SERVICE_DESIGN.md.
After=network-online.target
Wants=network-online.target
# Crash-loop limiter (these are [Unit] directives — ignored in [Service]).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=calypso
Group=calypso
WorkingDirectory=/opt/calypso
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/calypso"
Environment="GCP_PROJECT=calypso-trading-bot"
# Loopback-only bind (single-tenant VM). Override here if ever needed.
Environment="CALYPSO_BROKER_HOST=127.0.0.1"
Environment="CALYPSO_BROKER_PORT=8788"

# ─── IBKR OAuth 1.0a credentials ────────────────────────────────────────────
# This broker is the single OAuth identity / session owner: all three hydra*
# strategy units now set Environment="CALYPSO_BROKER_URL=http://127.0.0.1:8788"
# (committed in their unit files) so each runs as a BrokerClient proxy and opens
# NO direct IBKR session — eliminating the one-session-per-username eviction war.
# The hydra* units still carry their own LoadCredentialEncrypted= entries as a
# now-UNUSED fallback (they only matter on the direct-IBClient branch, which the
# committed CALYPSO_BROKER_URL disables); that cleanup is deferred — see
# docs/migration/PROJECT_STATUS.md.
LoadCredentialEncrypted=ibkr_consumer_key:/etc/calypso/ibkr/consumer_key.cred
LoadCredentialEncrypted=ibkr_access_token:/etc/calypso/ibkr/access_token.cred
LoadCredentialEncrypted=ibkr_access_token_secret:/etc/calypso/ibkr/access_token_secret.cred
LoadCredentialEncrypted=ibkr_signature_pem:/etc/calypso/ibkr/signature.pem.cred
LoadCredentialEncrypted=ibkr_encryption_pem:/etc/calypso/ibkr/encryption.pem.cred
LoadCredentialEncrypted=ibkr_dhparam_pem:/etc/calypso/ibkr/dhparam.pem.cred

ExecStart=/opt/calypso/.venv/bin/python -m services.broker.main

# A full restart cleanly re-runs connect() (fresh LST + Tickler) — also the
# fallback if the daily re-auth loop ever can't recover.
Restart=always
RestartSec=30
TimeoutStartSec=120

# Graceful stop: the FastAPI shutdown hook runs ib.disconnect() (stop Tickler +
# logout) so the IBKR session is released cleanly rather than left competing.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=calypso-broker

# ─── Sandboxing (defense-in-depth for a brokerage-credential service) ───────
# ProtectDevices=yes blocks /dev/* access (other than /dev/null, /dev/zero,
# /dev/random, etc.) — supported since systemd v183, so it is fully effective
# on the deploy host's build (252) and on the most sensitive service (the ONE
# process holding all decrypted OAuth private keys). Do NOT remove it.
# Verify with `systemd-analyze security calypso-broker`.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectDevices=yes
ReadWritePaths=/opt/calypso

[Install]
WantedBy=multi-user.target
