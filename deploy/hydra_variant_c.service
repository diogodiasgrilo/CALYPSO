[Unit]
Description=HYDRA Variant C (Brandon Trojan Horse stack — narrow widths + canonical 3-slot grid + 10c — dry-run paper)
# OAuth 1.0a is gateway-free and headless — no IB Gateway, no token-keeper
# service. network-online.target so the OAuth handshake to api.ibkr.com
# has DNS+TLS available at startup. P7-audit / Polish A-X2: the previous
# version of this file depended on token_keeper.service which is dead on
# this branch — variant would have failed to start on a clean VM.
After=network-online.target
Wants=network-online.target
# Restart rate-limiter. StartLimitIntervalSec/StartLimitBurst MUST be in
# [Unit]; in [Service] systemd silently ignores them (P7-audit H5).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=calypso
Group=calypso
WorkingDirectory=/opt/calypso
Environment="HYDRA_VARIANT_ID=c"
Environment="PYTHONUNBUFFERED=1"

# Variant-isolated state file paths (Polish Item 5 — pre-start snapshot).
Environment="STATE_FILE=/opt/calypso/data/variant_c/hydra_state.json"
Environment="SNAPSHOT_DIR=/opt/calypso/data/variant_c/state_snapshots"

# ─── IBKR OAuth 1.0a credentials (P7 Step 4) ────────────────────────────
# Variant C uses its OWN IBKR paper username + OAuth registration, delivered
# from /etc/calypso/ibkr-c/. IBKR allows only ONE brokerage session per
# username, so B/C CANNOT share A's session — three ssodh/init on one
# username evict each other (observed at cutover, 2026-05-29; see
# PROJECT_STATUS + docs/migration/IBKR_MULTI_SESSION.md). Each variant gets
# its own username/consumer key; the credential IDs below are unchanged
# (ib_oauth reads them by ID from $CREDENTIALS_DIRECTORY) — only the source
# paths differ per account.
LoadCredentialEncrypted=ibkr_consumer_key:/etc/calypso/ibkr-c/consumer_key.cred
LoadCredentialEncrypted=ibkr_access_token:/etc/calypso/ibkr-c/access_token.cred
LoadCredentialEncrypted=ibkr_access_token_secret:/etc/calypso/ibkr-c/access_token_secret.cred
LoadCredentialEncrypted=ibkr_signature_pem:/etc/calypso/ibkr-c/signature.pem.cred
LoadCredentialEncrypted=ibkr_encryption_pem:/etc/calypso/ibkr-c/encryption.pem.cred
LoadCredentialEncrypted=ibkr_dhparam_pem:/etc/calypso/ibkr-c/dhparam.pem.cred

EnvironmentFile=-/etc/calypso/polygon.env

# Pre-start state-file snapshot (Polish Item 5). Variant-aware.
ExecStartPre=/opt/calypso/scripts/pre_start_snapshot.sh

ExecStart=/opt/calypso/.venv/bin/python -m bots.hydra.main --config bots/hydra/config/config_variant_c.json

TimeoutStartSec=120
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydra_variant_c

# ─── Sandboxing (defense-in-depth, parity with hydra.service) ────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
# AUD2-L4 — see hydra.service for rationale
ProtectDevices=yes
ReadWritePaths=/opt/calypso

[Install]
WantedBy=multi-user.target
