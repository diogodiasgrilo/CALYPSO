[Unit]
Description=HYDRA 0DTE iron-condor bot (Interactive Brokers / ibind OAuth 1.0a)
# OAuth 1.0a is gateway-free and headless — no IB Gateway, no token-keeper
# service. network-online.target so the OAuth handshake to api.ibkr.com
# has DNS+TLS available at startup.
After=network-online.target
Wants=network-online.target
# Shared IBKR session: this strategy proxies all brokerage calls through
# calypso-broker (CALYPSO_BROKER_URL below). IBKR allows ONE session per
# username, so the broker must be up first — ordering + a soft dependency so
# `systemctl start hydra` pulls in calypso-broker, and it starts before us.
Wants=calypso-broker.service
After=calypso-broker.service
# Restart rate-limiter. StartLimitIntervalSec/StartLimitBurst are [Unit]
# directives — in [Service] systemd silently ignores them. If the bot
# crash-loops (e.g. expired IBKR credentials), systemd gives up after
# 5 starts in 600s instead of hammering api.ibkr.com forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=calypso
Group=calypso
WorkingDirectory=/opt/calypso
Environment="PYTHONUNBUFFERED=1"

# ─── Shared IBKR session (broker-proxy mode) ────────────────────────────
# bots/hydra/main.py:_build_broker() returns a BrokerClient (proxying the
# single shared calypso-broker session) when CALYPSO_BROKER_URL is set, and
# otherwise falls back to a direct IBClient that opens its OWN IBKR OAuth
# session. With A/B/C all running, three direct sessions on one paper
# username triggers the IBKR session-eviction crash-loop the broker pivot
# fixed — so the broker URL MUST be the tracked default, not a VM hand-edit.
Environment="CALYPSO_BROKER_URL=http://127.0.0.1:8788"

# ─── IBKR OAuth 1.0a credentials (P7 Step 4, option B) ──────────────────
# NOTE: in broker-proxy mode (CALYPSO_BROKER_URL above) the OAuth session is
# owned by calypso-broker.service, which holds these credentials. The
# LoadCredentialEncrypted= entries below are now redundant here and can be
# cleaned up in a follow-up pass once the cutover is confirmed on the VM;
# they are left in place for now so a fallback to direct-IBClient mode (URL
# unset) still has credentials available.
# systemd decrypts each credential into a file under $CREDENTIALS_DIRECTORY
# named exactly by its ID; shared/ib_oauth.load_credentials() reads them
# there. Credentials are NOT process env vars — not in /proc/<pid>/environ,
# not inherited by child processes, tmpfs-backed, encrypted at rest.
# One-time setup (encrypt the source values): see deploy/IBKR_CREDENTIALS_SETUP.md
LoadCredentialEncrypted=ibkr_consumer_key:/etc/calypso/ibkr/consumer_key.cred
LoadCredentialEncrypted=ibkr_access_token:/etc/calypso/ibkr/access_token.cred
LoadCredentialEncrypted=ibkr_access_token_secret:/etc/calypso/ibkr/access_token_secret.cred
LoadCredentialEncrypted=ibkr_signature_pem:/etc/calypso/ibkr/signature.pem.cred
LoadCredentialEncrypted=ibkr_encryption_pem:/etc/calypso/ibkr/encryption.pem.cred
LoadCredentialEncrypted=ibkr_dhparam_pem:/etc/calypso/ibkr/dhparam.pem.cred

# Optional: Polygon API key for Brandon GEX features (only used if the
# config enables the Brandon stack). Leading dash → file is optional.
EnvironmentFile=-/etc/calypso/polygon.env

# ─── Pre-start state-file snapshot (Polish Item 5) ──────────────────────
# Before each (re)start, snapshot data/hydra_state.json to
# data/state_snapshots/ so a corruption-on-restart (mid-write crash,
# partial JSON) is recoverable per RUNBOOKS.md RB-5. The script
# always exits 0 — a snapshot failure must NOT block bot start.
# Runs as User=calypso (no `+` prefix) since calypso has rw on data/.
ExecStartPre=/opt/calypso/scripts/pre_start_snapshot.sh

ExecStart=/opt/calypso/.venv/bin/python -m bots.hydra.main

# ExecStartPre timeout — default 90s. Snapshot should complete in <1s
# on a healthy disk; 120s gives headroom if disk IO is degraded but
# not enough that a hanging script blocks the bot for too long.
TimeoutStartSec=120

# Restart policy — matches the CALYPSO convention. A full restart cleanly
# re-runs IBClient.connect() (fresh live session token + Tickler), which
# is also the morning-reconnect fallback (see P7 Step 3 / main.py gate).
Restart=always
RestartSec=30

# Graceful stop: ibind registers a SIGTERM handler that runs oauth_shutdown
# (stop Tickler + logout). Give it time so the IBKR session is released
# cleanly rather than left as a competing session.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydra

# ─── Sandboxing (defense-in-depth for a brokerage-credential service) ───
# The service holds decrypted OAuth private keys; a code-execution bug in
# the ibind/strategy surface should not be able to escalate or write
# outside the bot's own tree. Verify with `systemd-analyze security hydra`.
#
# LoadCredentialEncrypted= above runs BEFORE these sandboxing directives
# take effect: systemd decrypts each .cred file with the host key, lands
# the plaintext in a private tmpfs at $CREDENTIALS_DIRECTORY, then drops
# the service into the sandbox. ProtectSystem=strict therefore does NOT
# block credential reading — the bot reads from the tmpfs, never from
# /etc/calypso/ibkr/ at runtime.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
# AUD2-L4: PrivateDevices=yes gives a private /dev with only the safe pseudo
# nodes (null, zero, full, random, urandom, tty); physical devices are hidden,
# so a code-execution bug can't read /dev/tpm0 or the host RNG directly.
# NB: the broader ProtectDevices=yes is SILENTLY IGNORED on this host's Debian
# systemd 252 build (verified: `systemctl show -p ProtectDevices` is empty and
# `systemd-analyze verify` reports "Unknown key"), so we use the supported
# PrivateDevices=yes, which delivers the same /dev isolation.
PrivateDevices=yes
# The bot writes only inside its own tree (data/, logs/, state files).
ReadWritePaths=/opt/calypso

[Install]
WantedBy=multi-user.target
