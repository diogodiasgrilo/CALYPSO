[Unit]
Description=Calypso ARGUS Health Check (oneshot)
Documentation=https://github.com/calypso-trading/calypso

[Service]
Type=oneshot
User=calypso
Group=calypso
# Check 6 (log-staleness liveness) runs `journalctl -u hydra`; as plain calypso
# that returns "No journal files were opened due to insufficient permissions",
# so the check was silently DEAD (always WARN, never able to detect a real
# stalled-log hang). systemd-journal group membership grants journald read
# access so Check 6 actually works.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/calypso

Environment="GCP_PROJECT=calypso-trading-bot"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/calypso"

ExecStart=/bin/bash /opt/calypso/services/argus/health_check.sh

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calypso-argus

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/calypso/intel/argus
ReadOnlyPaths=/opt/calypso/data /opt/calypso/services/argus /opt/calypso/.venv /opt/calypso/shared /opt/calypso/bots/hydra/config

# Timeout for the health check (should finish in seconds)
TimeoutStartSec=60
