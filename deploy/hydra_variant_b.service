[Unit]
Description=HYDRA Variant B (Brandon Trojan Horse stack — narrow widths + 4-slot grid + 10c — dry-run paper)
# OAuth 1.0a is gateway-free and headless — no IB Gateway, no token-keeper
# service. network-online.target so the OAuth handshake to api.ibkr.com
# has DNS+TLS available at startup. P7-audit / Polish A-X2: the previous
# version of this file depended on token_keeper.service which is dead on
# this branch — variant would have failed to start on a clean VM.
After=network-online.target
Wants=network-online.target
# Restart rate-limiter. StartLimitIntervalSec/StartLimitBurst MUST be in
# [Unit]; in [Service] systemd silently ignores them (P7-audit H5).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=calypso
Group=calypso
WorkingDirectory=/opt/calypso
Environment="HYDRA_VARIANT_ID=b"
Environment="PYTHONUNBUFFERED=1"

# Variant-isolated state file paths (Polish Item 5 — pre-start snapshot).
# Each variant has its own data/variant_<id>/ tree so the variants don't
# collide on state writes. The snapshot script reads these env vars to
# pick the right state file + snapshot dir.
Environment="STATE_FILE=/opt/calypso/data/variant_b/hydra_state.json"
Environment="SNAPSHOT_DIR=/opt/calypso/data/variant_b/state_snapshots"

# ─── IBKR OAuth 1.0a credentials (P7 Step 4) ────────────────────────────
# Variant B talks to IBKR's paper account (same credentials as the canonical
# bot — they query the same paper account; B is dry-run so it does NOT
# place real paper orders, but it DOES need real-time data via the same
# OAuth session). Polish A-X2: previous version had NO LoadCredentialEncrypted
# entries → variant would have failed on the first load_credentials call.
LoadCredentialEncrypted=ibkr_consumer_key:/etc/calypso/ibkr/consumer_key.cred
LoadCredentialEncrypted=ibkr_access_token:/etc/calypso/ibkr/access_token.cred
LoadCredentialEncrypted=ibkr_access_token_secret:/etc/calypso/ibkr/access_token_secret.cred
LoadCredentialEncrypted=ibkr_signature_pem:/etc/calypso/ibkr/signature.pem.cred
LoadCredentialEncrypted=ibkr_encryption_pem:/etc/calypso/ibkr/encryption.pem.cred
LoadCredentialEncrypted=ibkr_dhparam_pem:/etc/calypso/ibkr/dhparam.pem.cred

# Polygon API key for the Brandon GEX features. Create /etc/calypso/polygon.env
# with:  POLYGON_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
# The leading dash makes it optional — if the file is absent, GEX features
# silently disable (logged warning, no crash) and only TP + narrow_spread
# stay active.
EnvironmentFile=-/etc/calypso/polygon.env

# Pre-start state-file snapshot (Polish Item 5). Variant-aware via the
# STATE_FILE / SNAPSHOT_DIR env vars set above.
ExecStartPre=/opt/calypso/scripts/pre_start_snapshot.sh

ExecStart=/opt/calypso/.venv/bin/python -m bots.hydra.main --config bots/hydra/config/config_variant_b.json

TimeoutStartSec=120
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydra_variant_b

# ─── Sandboxing (defense-in-depth, parity with hydra.service) ────────────
# IMPORTANT: same sandboxing posture as the canonical bot. The variant
# also holds decrypted OAuth keys; the same threat model applies.
# LoadCredentialEncrypted= runs BEFORE ProtectSystem=strict takes effect.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
# AUD2-L4 — see hydra.service for rationale
ProtectDevices=yes
ReadWritePaths=/opt/calypso

[Install]
WantedBy=multi-user.target
