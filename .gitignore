# CALYPSO Trading Bots - Git Ignore
# ==================================
# Monorepo containing multiple trading bot strategies

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
.env/

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Configuration files with secrets - NEVER COMMIT THESE!
config/config.json
config/config.*.json
!config/config.example.json

# Bot-specific configs (in bots/*/config/)
bots/*/config/config.json
bots/*/config/config.*.json
!bots/*/config/config.example.json

# Google credentials - NEVER COMMIT!
config/google_credentials.json
config/*credentials*.json
bots/*/config/*credentials*.json
*.pem
*.key

# Log files
logs/
*.log
*.txt
bot_log*.txt
*_trades.json
# Explicit allow-list: pip requirements files MUST be version-controlled.
# The blanket *.txt ignore (line 64) was Saxo-era hygiene for bot_log_*.txt
# files; we preserve it but escape the pip-installable manifests.
!requirements.txt
!requirements-lock.txt
!requirements-dev.txt

# Data files (persistent state - machine specific)
data/

# Database files
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
# Backups operators/agents leave on the VM. `*.bak*` (not just `*.bak`) so it
# also catches the timestamp/label-suffixed ones the deploy + config-edit flows
# create, e.g. config_variant_c.json.bak-livetest-1120, dist.bak.20260427-…
*.bak*
*.backup
# Old dashboard build snapshots (the live build dir `dist/` is already ignored).
dist_old/
# Tool/cache dirs that leak into the repo root when gcloud / gsutil / pip run
# with /opt/calypso as cwd on the VM — never part of the project (may hold auth
# state, so they're ignored, not deleted).
.cache/
.config/
.gsutil/

# Test coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Session/state files
*.session
*.state

# Agent config (has alert credentials — created from template on VM)
services/agents_config.json

# Agent runtime reports (VM-only, regenerated daily). HOMER's deliverable is
# docs/HYDRA_TRADING_JOURNAL.md; the dated intel/homer/*.md + journal_backup_*
# are VM-only intermediates (older May files are still TRACKED from the
# pre-2026-06-16 `git add -A` bug — optional untrack noted in docs/NEXT_STEPS).
intel/argus/
intel/hermes/
intel/apollo/
intel/homer/
.odysseus_last_audit

# Backup files from editors
*~
\#*\#
.\#*

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.git-credentials

# Dashboard frontend — override Python/data rules for source files
!dashboard/frontend/src/lib/
!dashboard/frontend/src/components/logs/
backtest/results/
backtest/results/sweep_logs/

# Migration probe logs (local diagnostic evidence, not repo artifacts)
scripts/probe_chain_*.log
scripts/probe_trades_*.log
.claude/
